# Copy to `.env` and fill in values. Never commit `.env`.

# Better Auth — generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app (identity sign-in only) — https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub App (repository access) — https://github.com/settings/apps
# Permissions: Repository contents (Read-only)
# Setup URL: http://localhost:3000/api/github/install/callback
# After creating the app, install it once on your account to learn the slug from the URL.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_SLUG=""
