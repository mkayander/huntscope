# Copy to `.env` and fill in values. Never commit `.env`.

# Better Auth — generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app (optional cloud sign-in) — https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# GitHub App (optional repository access) — https://github.com/settings/apps
# Permissions: Repository contents (Read-only)
# Setup URL: http://localhost:3000/api/github/install/callback
# GITHUB_APP_ID=""
# GITHUB_APP_PRIVATE_KEY=""
# GITHUB_APP_SLUG=""
